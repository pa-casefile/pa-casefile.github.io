---
// English Homepage
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🔮 Magic Academy Raising Sim | Official Site</title>
  </head>
  <body>
    <nav class="sticky-nav">
      <div class="nav-container">
        <div class="logo">
          <a href="/en/">
            <img src="/images/logo_en.webp" alt="Game Title" class="logo-img" />
          </a>
        </div>
        <ul class="nav-links">
          <li><a href="#hero">Home</a></li>
          <li><a href="#story">Story</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="#characters">Characters</a></li>
        </ul>
        <div class="lang-switch">
          <a href="/">繁體中文</a> |
          <a href="/en/" class="active">English</a> |
          <a href="/ja/">日本語</a>
        </div>
      </div>
    </nav>

    <main class="one-page-scroll">
      <section id="hero" class="page-section hero-bg">
        <div class="section-content"></div>
      </section>

      <!-- 區塊：劇情內容 -->
      <section id="story" class="page-section story-bg">
        <div class="section-content story-layout">
          <!-- 🖼️ 上方：劇情截圖區（佔 2/3 空間） -->
          <div class="story-image-wrapper">
            <img src="/images/story_01.webp" alt="劇情截圖" class="story-img" />
          </div>

          <!-- 📜 下方：故事文案區（佔 1/3 空間） -->
          <div class="story-text-wrapper">
            <p class="story-highlight">
              "Solve this case, and you shall live."
            </p>
            <p class="story-desc">
              A girl calling herself a "Death Deity" suddenly whisks you away <br
              />
              to a isekai magic academy to master detective skills.<br />
              Her sole purpose? A single murder case—where the victim is none other
              than all of humanity!
            </p>
          </div>
        </div>
      </section>

      <!-- 區塊：遊戲特式 -->
      <section id="features" class="page-section features-bg">
        <div class="section-content features-layout">
          <!-- 💡 已依據需求移除 <h2> 標題，讓內容純粹留給輪播大圖 -->

          <!-- 🎡 輪播圖主容器 -->
          <div class="carousel-container">
            <!-- ⬅️ 左切換按鈕 -->
            <button
              class="carousel-btn prev-btn"
              id="prevBtn"
              aria-label="上一張">&#10094;</button
            >

            <!-- 🖼️ 中央截圖視窗 -->
            <div class="carousel-window">
              <div class="carousel-track" id="carouselTrack">
                <div class="carousel-slide">
                  <img src="/images/features_01_en.webp" alt="Academy Life 1" />
                </div>
                <div class="carousel-slide">
                  <img src="/images/features_02_en.webp" alt="Academy Life 2" />
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/features_03_en.webp"
                    alt="Investigation 1"
                  />
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/features_04_en.webp"
                    alt="Investigation 2"
                  />
                </div>
              </div>
            </div>

            <!-- ➡️ 右切換按鈕 -->
            <button
              class="carousel-btn next-btn"
              id="nextBtn"
              aria-label="下一張">&#10095;</button
            >
          </div>

          <!-- 🟢 下方圓點指示器 -->
          <div class="carousel-dots" id="carouselDots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
            <span class="dot" data-index="3"></span>
          </div>
        </div>
      </section>

      <!-- 區塊：角色介紹 -->
      <section id="characters" class="page-section char-bg">
        <div class="section-content char-layout">
          <!-- 🏛️ 左側區域：文字資訊、切換箭頭與頭像選單 -->
          <div class="char-left-zone">
            <!-- 📜 左側上部：人物故事資訊卡（內含 6 位角色的文字軌道） -->
            <div class="char-info-window">
              <div class="char-info-track" id="charInfoTrack">
                <!-- 角色 1 -->
                <div class="char-info-slide">
                  <h3 class="char-name">You</h3>
                  <span class="char-tag">Goofball by the Styx</span>
                  <p class="char-bio">
                    被死神少女強行帶到神祕魔法學園的倒楣死者。為了生存，你必須在「玻里蒂亞」內不斷磨練探案技巧，抽絲剝繭揭開即將毀滅全人類的終極凶案。
                  </p>
                </div>

                <!-- 角色 2 -->
                <div class="char-info-slide">
                  <h3 class="char-name">Mors</h3>
                  <span class="char-tag">Frost White Crow</span>
                  <p class="char-bio">
                    思考清晰。拒絕一切古風或晦澀文風的青年。眼前的線索在他腦海中會自動重組，隨時保持著絕對冷靜與客觀的破案直覺。
                  </p>
                </div>

                <!-- 角色 3 -->
                <div class="char-info-slide">
                  <h3 class="char-name">Echo</h3>
                  <span class="char-tag">Fantasy Grimoire</span>
                  <p class="char-bio">
                    學園深處的神祕少女。言談舉止間絕少使用語氣助詞，語調冰冷而堅定。她似乎掌握了死神與魔法學園之間那道不可告人的禁忌聯繫。
                  </p>
                </div>

                <!-- 角色 4 -->
                <div class="char-info-slide">
                  <h3 class="char-name">Orphne</h3>
                  <span class="char-tag">Nonexistent</span>
                  <p class="char-bio">
                    魔法學園「玻里蒂亞」的登場人物，相關情報與背景故事正在百科全書中逐步解鎖中。
                  </p>
                </div>

                <!-- 角色 5 -->
                <div class="char-info-slide">
                  <h3 class="char-name">Eurydike</h3>
                  <span class="char-tag">Aloof Genius</span>
                  <p class="char-bio">
                    魔法學園「玻里蒂亞」的登場人物，相關情報與背景故事正在百科全書中逐步解鎖中。
                  </p>
                </div>

                <!-- 角色 6 -->
                <div class="char-info-slide">
                  <h3 class="char-name">Maniae</h3>
                  <span class="char-tag">Sea Breeze Maiden</span>
                  <p class="char-bio">
                    魔法學園「玻里蒂亞」的登場人物，相關情報與背景故事正在百科全書中逐步解鎖中。
                  </p>
                </div>
              </div>
            </div>

            <!-- 🎮 左側下部：左右箭頭與 6 個角色頭像點選選單 -->
            <div class="char-nav-wrapper">
              <!-- ⬅️ 左箭頭 -->
              <button
                class="char-arrow-btn"
                id="charPrevBtn"
                aria-label="上一個角色">&#10094;</button
              >

              <!-- 6位角色的橫向點選頭像 -->
              <div class="char-avatar-menu">
                <div class="avatar-box active" data-char="0">
                  <img src="/images/ch_thumb_01.webp" alt="頭像1" />
                </div>
                <div class="avatar-box" data-char="1">
                  <img src="/images/ch_thumb_02.webp" alt="頭像2" />
                </div>
                <div class="avatar-box" data-char="2">
                  <img src="/images/ch_thumb_03.webp" alt="頭像3" />
                </div>
                <div class="avatar-box" data-char="3">
                  <img src="/images/ch_thumb_04.webp" alt="頭像4" />
                </div>
                <div class="avatar-box" data-char="4">
                  <img src="/images/ch_thumb_05.webp" alt="頭像5" />
                </div>
                <div class="avatar-box" data-char="5">
                  <img src="/images/ch_thumb_06.webp" alt="頭像6" />
                </div>
              </div>

              <!-- ➡️ 右箭頭 -->
              <button
                class="char-arrow-btn"
                id="charNextBtn"
                aria-label="下一個角色">&#10095;</button
              >
            </div>
          </div>

          <!-- 🖼️ 右側區域：角色去背全身立繪展示窗 -->
          <div class="char-right-zone">
            <div class="char-image-window">
              <div class="char-image-track" id="charImageTrack">
                <div class="char-img-slide">
                  <img src="/images/ch_full_01.webp" alt="角色1立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_02.webp" alt="角色2立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_03.webp" alt="角色3立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_04.webp" alt="角色4立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_05.webp" alt="角色5立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_06.webp" alt="角色6立繪" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  /* 這裡的 CSS 樣式三個語言檔案都通用，我把多語言的樣式寫在最下方 */
  html {
    scroll-behavior: smooth;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: sans-serif;
    margin: 0;
    background-color: #0b0b16;
    color: #fff;
  }
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 130px; /* 🆙 從 70px 放大到 130px，讓 100px 的 LOGO 上下各有 15px 的完美留白 */
    background: rgba(11, 11, 22, 0.85);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .logo-img {
    height: 100px; /* 🔒 依你所願，強制鎖定高度為 100 像素 */
    width: auto; /* 📐 寬度依舊等比例縮放，確保圖片不扁塌變形 */
    display: block;
    object-fit: contain;
    transition: transform 0.2s;
  }
  .logo-img:hover {
    transform: scale(
      1.03
    ); /* 因為圖片變大了，放大效果調微幅一點（1.03倍）才不會太突兀 */
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 1.1rem;
    transition: color 0.3s;
  }
  .nav-links a:hover {
    color: #da9100;
  }
  .page-section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 130px; /* 🆙 這裡也要同步改成 130px！預留導覽列的高度，後面的遊戲內容才不會被壓在選單下方 */
    box-sizing: border-box;
  }
  .section-content {
    max-width: 1000px;
    width: 100%;
    padding: 40px;
    text-align: center;
  }
  .hero-bg {
    background-image: url("/images/main_title.webp"); /* 🎯 精準讀取你存放在 public/images/ 的大圖 */
    background-position: center center; /* 📐 圖片永遠保持置中 */
    background-repeat: no-repeat; /* 🚫 圖片太大或太小時，絕對不重複磁磚拼貼 */
    background-size: cover; /* 🔒 核心：強制圖片等比例縮放，完美撐滿整個螢幕畫面，絕不變形 */
    position: relative;
  }
  /* 🔮 1. 故事區域背景：放入你的模糊背景大圖 */
  .story-bg {
    background-image: url("/images/story_bg_blur.webp"); /* 🎯 這裡換上你模糊化處理後的大背景圖 */
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
  }

  /* 🖼️ 2. 微調截圖樣式：讓它在模糊背景前更立體 */
  .story-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 12px; /* 稍微加大圓角，更顯精緻 */
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6); /* 加深陰影，讓截圖從背景中「跳」出來 */
  }

  /* 📜 3. 核心：將文字用半透明黑色方塊包起來 */
  .story-text-wrapper {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 800px; /* 📐 限制方塊的最大寬度，避免在寬螢幕上拉得太寬 */
    text-align: center;

    /* 👇 半透明黑色方塊的核心程式碼 👇 */
    background: rgba(
      0,
      0,
      0,
      0.65
    ); /* 🖤 黑色底色，0.65 代表 65% 的透明度，既能擋住背景，又能隱約透出後方色彩 */
    padding: 25px 40px; /* ↕️ 幫方塊內部留出上下 25px、左右 40px 的舒適閱讀空間 */
    border-radius: 16px; /* ⚪ 柔和的圓角外框 */
    border: 1px solid rgba(255, 255, 255, 0.1); /* ✨ 極細的半透明白邊，能幫方塊增加一圈優雅的高級「科技/魔法邊框感」 */
    backdrop-filter: blur(
      5px
    ); /* 🌫️ 如果你希望黑色方塊自己也有二次模糊效果，可以加上這行（選用） */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); /* 底部加上柔和陰影 */
  }

  /* 調整字體邊距，讓它在方塊內更好看 */
  .story-highlight {
    font-size: 1.6rem;
    font-weight: bold;
    color: #da9100;
    margin-top: 0; /* 🆕 消除方塊內頂部的多餘空間 */
    margin-bottom: 12px;
    letter-spacing: 2px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); /* 給金字加上黑陰影，更立體 */
  }

  .story-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #f0f0f0; /* 稍微調亮白字，對比度更高 */
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); /* 給白字加上黑陰影 */
  }

  /* 📱 行動端微調：讓手機版玩家看時，黑框不會擠滿螢幕 */
  @media (max-width: 768px) {
    .story-text-wrapper {
      padding: 20px 20px;
      width: 90%; /* 在手機上左右保留一點點邊距，看起來像一張懸浮的卡片 */
    }
  }

  /* 直立式上下配置容器 */
  .story-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* 🎯 修正：從 space-between 改為 center，讓圖文往中間靠攏 */
    gap: 20px; /* 📐 核心：精準設定圖片與文字之間「只留 20 像素」的舒適空隙 */
    height: calc(100vh - 130px);
    max-width: 900px;
    padding: 20px 0;
  }

  /* 🖼️ 圖片外框 */
  .story-image-wrapper {
    flex: 0 1 auto; /* 🎯 修正：取消強制的 2 等分，讓圖片依據自身大小與螢幕高度自動縮放 */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-height: 55vh;
    overflow: hidden;
  }

  /* 金色粗體標語 */
  .story-highlight {
    font-size: 1.6rem;
    font-weight: bold;
    color: #da9100; /* 金色 */
    margin-bottom: 15px;
    letter-spacing: 2px;
  }

  /* 白字劇情描述 */
  .story-desc {
    font-size: 1.1rem;
    line-height: 1.8; /* 舒適的行高 */
    color: #e0e0e0;
    margin: 0;
  }

  /* 📱 貼心 RWD 行動端優化：當玩家用手機直立觀看時，自動微調字體大小防止跑版 */
  @media (max-width: 768px) {
    .story-highlight {
      font-size: 1.25rem;
    }
    .story-desc {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }

  /* 🏫 遊戲特式背景 */
  .features-bg {
    background-image: url("/images/features_bg_blur.webp");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
  }

  /* 🏫 遊戲特式佈局容器（強制完全置中） */
  .features-layout {
    display: flex;
    flex-direction: column;
    align-items: center; /* 🎯 確保所有內層元件水平正置中 */
    justify-content: center; /* 🎯 確保所有內層元件垂直正置中 */
    gap: 15px;
    height: calc(100vh - 130px);
    width: 100%;
    padding: 10px 0;
    margin: 0 auto; /* 🛡️ 保險：左右外邊距自動平分 */
  }

  /* ⚡ 新增：徹底清除最初設定的全域置中干擾，強制清除多餘推力 */
  .features-layout.section-content {
    max-width: 100%; /* 🔓 解開原本 1000px 的寬度限制，讓 124.44vh 的大圖自由舒展 */
    padding: 0; /* 🚫 拔除左右內邊距，防止一邊多一邊少導致偏向 */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* 🎡 輪播圖主容器 */
  .carousel-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 124.44vh;
    max-width: 85vw;
    margin: 0 auto; /* 🎯 核心：強制左右外邊距完美平分，將圖表鎖死在螢幕正中央 */
  }

  /* 🎡 輪播圖主容器：改成純粹的置中基準點，寬度完全不限制內層 */
  .carousel-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 124.44vh; /* 🎯 核心：直接把外殼寬度鎖定為完美的 16:9 寬度 */
    max-width: 85vw; /* 🛡️ 安全防護：在窄螢幕下最多佔螢幕寬 85%，絕對不超出螢幕 */
    margin: 0 auto;
  }

  /* 🖼️ 中央截圖視窗：100% 獨立，與按鈕完全沒有任何鄰居關係 */
  .carousel-window {
    height: 70vh; /* 🔒 依你所願，高度嚴格鎖定 70% */
    max-height: 70vh;
    width: 100%; /* 📐 直接吃滿上方 container 的 124.44vh 完美寬度 */

    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(0, 0, 0, 0.4);
  }

  /* 🏃 圖片軌道 */
  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .carousel-slide {
    min-width: 100%;
    height: 100%;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 📐 比例完美後，cover 會嚴絲合縫填滿，絕不留白或變形 */
  }

  /* ⬅️ ➡️ 左右切換按鈕：改成「全懸浮」模式，完全不參與任何 Flexbox 寬度分配 */
  .carousel-btn {
    position: absolute; /* 🚀 核心：改為絕對定位，與大圖完全分層 */
    top: 50%; /* ↕️ 垂直置中 */
    transform: translateY(-50%);

    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 55px;
    height: 55px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    user-select: none;
    z-index: 10;
  }

  /* 🎯 精準定位：將按鈕強行推到 16:9 方塊的「正外側」，中間預留 30px 空隙，且絕對不回彈擠壓圖片 */
  .prev-btn {
    left: -85px; /* 🔍 剛好掛在大圖左邊緣外側 85 像素的位置 */
  }

  .next-btn {
    right: -85px; /* 🔍 剛好掛在大圖右邊緣外側 85 像素的位置 */
  }

  /* Hover 動態回饋 */
  .carousel-btn:hover {
    background: #da9100;
    border-color: #da9100;
    transform: translateY(-50%) scale(1.1);
  }

  /* 🟢 下方圓點指示器樣式 */
  .carousel-dots {
    display: flex;
    gap: 12px;
    margin-top: 5px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s;
  }

  .dot.active {
    background: #da9100;
    width: 24px;
    border-radius: 5px;
  }

  /* 📱 貼心行動端/小螢幕防爆優化：萬一螢幕不夠寬（如筆電或手機），自動把按鈕收進圖片內部 */
  @media (max-width: 1450px) {
    .carousel-container {
      width: 100%;
      max-width: 85vw;
    }
    .carousel-window {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    } /* 🛡️ 在小螢幕下改用 CSS 比例鎖定 */
    .prev-btn {
      left: 20px;
      transform: translateY(-50%);
    }
    .next-btn {
      right: 20px;
      transform: translateY(-50%);
    }
    .prev-btn:hover,
    .next-btn:hover {
      transform: translateY(-50%) scale(1.1);
    }
  }

  @media (max-width: 768px) {
    .carousel-window {
      height: auto;
      max-height: 50vh;
      width: 100%;
    }
    .carousel-btn {
      width: 45px;
      height: 45px;
    }
  }

  .characters-bg {
    background: #1a1a3a;
  }

  /* 🌐 語言切換專用樣式 */
  .lang-switch {
    color: #666;
    font-size: 1rem;
  }
  .lang-switch a {
    color: #aaa;
    text-decoration: none;
    margin: 0 5px;
    transition: color 0.3s;
  }
  .lang-switch a:hover {
    color: #da9100;
  }
  .lang-switch a.active {
    color: #da9100;
    font-weight: bold;
  } /* 當前語系亮起金色 */
</style>

<!-- 👇 TypeScript 語法安全修復版 輪播圖控制碼 👇 -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 🎯 使用 HTMLTrackElement 和 HTMLButtonElement 明確告訴 VS Code 元件類型，並加上安全判斷
    const track = document.getElementById(
      "carouselTrack",
    ) as HTMLElement | null;
    const prevBtn = document.getElementById(
      "prevBtn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "nextBtn",
    ) as HTMLButtonElement | null;
    const dots = document.querySelectorAll(".dot");

    let currentIndex = 0;
    const totalSlides = dots.length;

    // 如果關鍵元件沒抓到，就直接終止，避免網頁崩潰（這能讓 VS Code 完全閉嘴）
    if (!track || !prevBtn || !nextBtn) return;

    // 🔒 幫 index 參數明確指定為 'number' 類型，解決 implicitly has an 'any' type 的警告
    function updateCarousel(index: number) {
      currentIndex = index;
      track!.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add("active");
        } else {
          dot.classList.remove("active");
        }
      });
    }

    // ⬅️ 點擊左鍵
    prevBtn.addEventListener("click", () => {
      let index = currentIndex - 1;
      if (index < 0) index = totalSlides - 1;
      updateCarousel(index);
    });

    // ➡️ 點擊右鍵
    nextBtn.addEventListener("click", () => {
      let index = currentIndex + 1;
      if (index >= totalSlides) index = 0;
      updateCarousel(index);
    });

    // 🟢 點擊下方小圓點直接跳轉
    dots.forEach((dot) => {
      dot.addEventListener("click", (e: Event) => {
        // 🎯 將 e.target 強制轉換為 HTMLElement 類型，這樣就能完美使用 getAttribute 功能
        const target = e.target as HTMLElement | null;
        if (target) {
          const attr = target.getAttribute("data-index");
          if (attr) {
            const index = parseInt(attr);
            updateCarousel(index);
          }
        }
      });
    });
  });
</script>
