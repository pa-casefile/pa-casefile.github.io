---
// English Homepage
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🔮 Magic Academy Raising Sim | Official Site</title>
  </head>
  <body>
    <nav class="sticky-nav">
      <div class="nav-container">
        <div class="logo">
          <a href="/en/">
            <img src="/images/logo_en.webp" alt="Game Title" class="logo-img" />
          </a>
        </div>
        <ul class="nav-links">
          <li><a href="#hero">Home</a></li>
          <li><a href="#story">Story</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="#characters">Characters</a></li>
        </ul>
        <div class="lang-switch">
          <a href="/">繁體中文</a> |
          <a href="/en/" class="active">English</a> |
          <a href="/ja/">日本語</a>
        </div>
      </div>
    </nav>

    <main class="one-page-scroll">
      <section id="hero" class="page-section hero-bg">
        <div class="section-content"></div>
      </section>

      <!-- 區塊：劇情內容 -->
      <section id="story" class="page-section story-bg">
        <div class="section-content story-layout">
          <!-- 🖼️ 上方：劇情截圖區（佔 2/3 空間） -->
          <div class="story-image-wrapper">
            <img src="/images/story_01.webp" alt="劇情截圖" class="story-img" />
          </div>

          <!-- 📜 下方：故事文案區（佔 1/3 空間） -->
          <div class="story-text-wrapper">
            <p class="story-highlight">
              "Solve this case, and you shall live."
            </p>
            <p class="story-desc">
              A girl calling herself a "Death Deity" suddenly whisks you away <br
              />
              to a isekai magic academy to master detective skills.<br />
              Her sole purpose? A single murder case—where the victim is none other
              than all of humanity!
            </p>
          </div>
        </div>
      </section>

      <!-- 區塊：遊戲特式 -->
      <section id="features" class="page-section features-bg">
        <div class="section-content features-layout">
          <!-- 💡 已依據需求移除 <h2> 標題，讓內容純粹留給輪播大圖 -->

          <!-- 🎡 輪播圖主容器 -->
          <div class="carousel-container">
            <!-- ⬅️ 左切換按鈕 -->
            <button
              class="carousel-btn prev-btn"
              id="prevBtn"
              aria-label="上一張">&#10094;</button
            >

            <!-- 🖼️ 中央截圖視窗 -->
            <div class="carousel-window">
              <div class="carousel-track" id="carouselTrack">
                <div class="carousel-slide">
                  <img src="/images/feature_01.webp" alt="角色養成系統" />
                </div>
                <div class="carousel-slide">
                  <img src="/images/feature_02.webp" alt="魔法學園生活" />
                </div>
                <div class="carousel-slide">
                  <img src="/images/feature_03.webp" alt="偵探搜查推理" />
                </div>
              </div>
            </div>

            <!-- ➡️ 右切換按鈕 -->
            <button
              class="carousel-btn next-btn"
              id="nextBtn"
              aria-label="下一張">&#10095;</button
            >
          </div>

          <!-- 🟢 下方圓點指示器 -->
          <div class="carousel-dots" id="carouselDots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
          </div>
        </div>
      </section>

      <section id="characters" class="page-section characters-bg">
        <div class="section-content">
          <h2>🔍 Characters</h2>
          <p>Dynamic profiles for lynceus, eurydike, and more...</p>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  /* 保持與繁中相同的 CSS */
  html {
    scroll-behavior: smooth;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: sans-serif;
    margin: 0;
    background-color: #0b0b16;
    color: #fff;
  }
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 130px; /* 🆙 從 70px 放大到 130px，讓 100px 的 LOGO 上下各有 15px 的完美留白 */
    background: rgba(11, 11, 22, 0.85);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .logo-img {
    height: 100px; /* 🔒 依你所願，強制鎖定高度為 100 像素 */
    width: auto; /* 📐 寬度依舊等比例縮放，確保圖片不扁塌變形 */
    display: block;
    object-fit: contain;
    transition: transform 0.2s;
  }
  .logo-img:hover {
    transform: scale(
      1.03
    ); /* 因為圖片變大了，放大效果調微幅一點（1.03倍）才不會太突兀 */
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 1.1rem;
    transition: color 0.3s;
  }
  .nav-links a:hover {
    color: #da9100;
  }
  .page-section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 130px; /* 🆙 這裡也要同步改成 130px！預留導覽列的高度，後面的遊戲內容才不會被壓在選單下方 */
    box-sizing: border-box;
  }
  .section-content {
    max-width: 1000px;
    width: 100%;
    padding: 40px;
    text-align: center;
  }
  .hero-bg {
    background-image: url("/images/main_title.webp"); /* 🎯 精準讀取你存放在 public/images/ 的大圖 */
    background-position: center center; /* 📐 圖片永遠保持置中 */
    background-repeat: no-repeat; /* 🚫 圖片太大或太小時，絕對不重複磁磚拼貼 */
    background-size: cover; /* 🔒 核心：強制圖片等比例縮放，完美撐滿整個螢幕畫面，絕不變形 */
    position: relative;
  }
  /* 🔮 1. 故事區域背景：放入你的模糊背景大圖 */
  .story-bg {
    background-image: url("/images/story_bg_blur.webp"); /* 🎯 這裡換上你模糊化處理後的大背景圖 */
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
  }

  /* 🖼️ 2. 微調截圖樣式：讓它在模糊背景前更立體 */
  .story-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 12px; /* 稍微加大圓角，更顯精緻 */
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6); /* 加深陰影，讓截圖從背景中「跳」出來 */
  }

  /* 📜 3. 核心：將文字用半透明黑色方塊包起來 */
  .story-text-wrapper {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 800px; /* 📐 限制方塊的最大寬度，避免在寬螢幕上拉得太寬 */
    text-align: center;

    /* 👇 半透明黑色方塊的核心程式碼 👇 */
    background: rgba(
      0,
      0,
      0,
      0.65
    ); /* 🖤 黑色底色，0.65 代表 65% 的透明度，既能擋住背景，又能隱約透出後方色彩 */
    padding: 25px 40px; /* ↕️ 幫方塊內部留出上下 25px、左右 40px 的舒適閱讀空間 */
    border-radius: 16px; /* ⚪ 柔和的圓角外框 */
    border: 1px solid rgba(255, 255, 255, 0.1); /* ✨ 極細的半透明白邊，能幫方塊增加一圈優雅的高級「科技/魔法邊框感」 */
    backdrop-filter: blur(
      5px
    ); /* 🌫️ 如果你希望黑色方塊自己也有二次模糊效果，可以加上這行（選用） */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); /* 底部加上柔和陰影 */
  }

  /* 調整字體邊距，讓它在方塊內更好看 */
  .story-highlight {
    font-size: 1.6rem;
    font-weight: bold;
    color: #da9100;
    margin-top: 0; /* 🆕 消除方塊內頂部的多餘空間 */
    margin-bottom: 12px;
    letter-spacing: 2px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); /* 給金字加上黑陰影，更立體 */
  }

  .story-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #f0f0f0; /* 稍微調亮白字，對比度更高 */
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); /* 給白字加上黑陰影 */
  }

  /* 📱 行動端微調：讓手機版玩家看時，黑框不會擠滿螢幕 */
  @media (max-width: 768px) {
    .story-text-wrapper {
      padding: 20px 20px;
      width: 90%; /* 在手機上左右保留一點點邊距，看起來像一張懸浮的卡片 */
    }
  }

  /* 直立式上下配置容器 */
  .story-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* 🎯 修正：從 space-between 改為 center，讓圖文往中間靠攏 */
    gap: 20px; /* 📐 核心：精準設定圖片與文字之間「只留 20 像素」的舒適空隙 */
    height: calc(100vh - 130px);
    max-width: 900px;
    padding: 20px 0;
  }

  /* 🖼️ 圖片外框 */
  .story-image-wrapper {
    flex: 0 1 auto; /* 🎯 修正：取消強制的 2 等分，讓圖片依據自身大小與螢幕高度自動縮放 */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-height: 55vh;
    overflow: hidden;
  }

  /* 金色粗體標語 */
  .story-highlight {
    font-size: 1.6rem;
    font-weight: bold;
    color: #da9100; /* 金色 */
    margin-bottom: 15px;
    letter-spacing: 2px;
  }

  /* 白字劇情描述 */
  .story-desc {
    font-size: 1.1rem;
    line-height: 1.8; /* 舒適的行高 */
    color: #e0e0e0;
    margin: 0;
  }

  /* 📱 貼心 RWD 行動端優化：當玩家用手機直立觀看時，自動微調字體大小防止跑版 */
  @media (max-width: 768px) {
    .story-highlight {
      font-size: 1.25rem;
    }
    .story-desc {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }

  /* 🏫 遊戲特式背景 */
  .features-bg {
    background-image: url("/images/features_bg_blur.webp");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
  }

  /* 佈局容器：拿掉標題後，微調間距讓重心完美居中 */
  .features-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px; /* 🤏 縮減間距，留出更多垂直空間給大圖 */
    height: calc(100vh - 130px);
    width: 100%;
    padding: 10px 0;
  }

  /* 🎡 輪播圖主容器 */
  .carousel-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative; /* 🎯 設定為相對定位，作為內層懸浮按鈕的基準點 */
  }

  /* 🖼️ 中央截圖視窗：100% 擺脫按鈕擠壓，鎖定 16:9 巨型黃金比例 */
  .carousel-window {
    height: 70vh; /* 🔒 鎖定高度為螢幕區域的 70% */
    max-height: 70vh;
    width: 124.44vh; /* 📐 70vh * (16/9)，此時沒有按鈕強推，寬度會 100% 精準拉開 */
    max-width: 85vw; /* 🛡️ 安全防護：限制最寬只能佔螢幕寬度的 85%，預留左右空間，大螢幕下絕對不跑版 */

    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(0, 0, 0, 0.4);
  }

  /* 🏃 圖片軌道 */
  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .carousel-slide {
    min-width: 100%;
    height: 100%;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 📐 方塊形狀精準後，cover 會讓 16:9 的遊戲截圖嚴絲合縫完美填滿 */
  }

  /* ⬅️ ➡️ 左右切換按鈕：改成「懸浮」模式，絕對不佔寬度空間 */
  .carousel-btn {
    position: absolute; /* 🚀 核心修改：改為絕對定位，讓它像幽靈一樣浮在圖片上方 */
    top: 50%; /* ↕️ 垂直居中 */
    transform: translateY(-50%); /* ↕️ 完美對齊中心點 */

    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 55px;
    height: 55px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    user-select: none;
    z-index: 10; /* 🔝 確保按鈕永遠浮在圖片的最上層，點得到 */
  }

  /* 🎯 精準定位左、右按鈕的懸浮座標（剛好貼在 16:9 方塊的兩側外緣） */
  .prev-btn {
    left: calc(
      50% - (124.44vh / 2) - 80px
    ); /* 🔍 從中央往左推半個大圖寬度，再外留 80px 距離 */
  }

  .next-btn {
    right: calc(
      50% - (124.44vh / 2) - 80px
    ); /* 🔍 從中央往右推半個大圖寬度，再外留 80px 距離 */
  }

  /*  Hover 動態回饋 */
  .carousel-btn:hover {
    background: #da9100;
    border-color: #da9100;
    transform: translateY(-50%) scale(1.1); /* 🔥 注意：因為有垂直居中，放大時要保留 translateY */
  }

  /* 🟢 下方圓點指示器樣式 */
  .carousel-dots {
    display: flex;
    gap: 12px;
    margin-top: 5px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s;
  }

  .dot.active {
    background: #da9100;
    width: 24px;
    border-radius: 5px;
  }

  /* 📱 貼心行動端/小螢幕防爆優化：萬一螢幕不夠寬，自動把按鈕收進圖片內部 */
  @media (max-width: 1400px) {
    .prev-btn {
      left: 20px;
      transform: translateY(-50%);
    }
    .next-btn {
      right: 20px;
      transform: translateY(-50%);
    }
    .prev-btn:hover,
    .next-btn:hover {
      transform: translateY(-50%) scale(1.1);
    }
  }

  @media (max-width: 768px) {
    .carousel-window {
      height: auto;
      max-height: 50vh;
      width: 100%;
    }
    .carousel-btn {
      width: 45px;
      height: 45px;
    }
  }

  .characters-bg {
    background: #1a1a3a;
  }
  .lang-switch {
    color: #666;
    font-size: 1rem;
  }
  .lang-switch a {
    color: #aaa;
    text-decoration: none;
    margin: 0 5px;
    transition: color 0.3s;
  }
  .lang-switch a:hover {
    color: #da9100;
  }
  .lang-switch a.active {
    color: #da9100;
    font-weight: bold;
  }
</style>

<!-- 👇 TypeScript 語法安全修復版 輪播圖控制碼 👇 -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 🎯 使用 HTMLTrackElement 和 HTMLButtonElement 明確告訴 VS Code 元件類型，並加上安全判斷
    const track = document.getElementById(
      "carouselTrack",
    ) as HTMLElement | null;
    const prevBtn = document.getElementById(
      "prevBtn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "nextBtn",
    ) as HTMLButtonElement | null;
    const dots = document.querySelectorAll(".dot");

    let currentIndex = 0;
    const totalSlides = dots.length;

    // 如果關鍵元件沒抓到，就直接終止，避免網頁崩潰（這能讓 VS Code 完全閉嘴）
    if (!track || !prevBtn || !nextBtn) return;

    // 🔒 幫 index 參數明確指定為 'number' 類型，解決 implicitly has an 'any' type 的警告
    function updateCarousel(index: number) {
      currentIndex = index;
      track!.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add("active");
        } else {
          dot.classList.remove("active");
        }
      });
    }

    // ⬅️ 點擊左鍵
    prevBtn.addEventListener("click", () => {
      let index = currentIndex - 1;
      if (index < 0) index = totalSlides - 1;
      updateCarousel(index);
    });

    // ➡️ 點擊右鍵
    nextBtn.addEventListener("click", () => {
      let index = currentIndex + 1;
      if (index >= totalSlides) index = 0;
      updateCarousel(index);
    });

    // 🟢 點擊下方小圓點直接跳轉
    dots.forEach((dot) => {
      dot.addEventListener("click", (e: Event) => {
        // 🎯 將 e.target 強制轉換為 HTMLElement 類型，這樣就能完美使用 getAttribute 功能
        const target = e.target as HTMLElement | null;
        if (target) {
          const attr = target.getAttribute("data-index");
          if (attr) {
            const index = parseInt(attr);
            updateCarousel(index);
          }
        }
      });
    });
  });
</script>
