---
// English Homepage
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🔮 Magic Academy Raising Sim | Official Site</title>
</head>
<body>

  <nav class="sticky-nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/ja/">
          <img src="/images/logo_ja.png" alt="ゲームタイトル" class="logo-img" />
        </a>
      </div>
      <ul class="nav-links">
        <li><a href="#hero">Home</a></li>
        <li><a href="#story">Story</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#characters">Characters</a></li>
      </ul>
      <div class="lang-switch">
        <a href="/">繁體中文</a> | 
        <a href="/en/" class="active">English</a> | 
        <a href="/ja/">日本語</a>
      </div>
    </div>
  </nav>

  <main class="one-page-scroll">
    <section id="hero" class="page-section hero-bg">
      <div class="section-content">
        <h1>🎮 Game Key Art & Title</h1>
        <p>Demo Download / Web Build Play Button Placeholder</p>
      </div>
    </section>

    <section id="story" class="page-section story-bg">
      <div class="section-content">
        <h2>🔮 Story</h2>
        <p>"All the realm's secrets lie within the Encyclopedia. Welcome to the academy..."</p>
      </div>
    </section>

    <section id="features" class="page-section features-bg">
      <div class="section-content">
        <h2>🏫 Features</h2>
        <p>Character Raising Sim, Magic Academy Life, Investigation & Deduction...</p>
      </div>
    </section>

    <section id="characters" class="page-section characters-bg">
      <div class="section-content">
        <h2>🔍 Characters</h2>
        <p>Dynamic profiles for lynceus, eurydike, and more...</p>
      </div>
    </section>
  </main>

</body>
</html>

<style>
  /* 保持與繁中相同的 CSS */
  html { scroll-behavior: smooth; margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: sans-serif; margin: 0; background-color: #0b0b16; color: #fff; }
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 130px; /* 🆙 從 70px 放大到 130px，讓 100px 的 LOGO 上下各有 15px 的完美留白 */
    background: rgba(11, 11, 22, 0.85);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .logo-img {
	height: 100px; /* 🔒 依你所願，強制鎖定高度為 100 像素 */
    width: auto;   /* 📐 寬度依舊等比例縮放，確保圖片不扁塌變形 */
    display: block;
    object-fit: contain;
    transition: transform 0.2s;
  }
  .logo-img:hover {
    transform: scale(1.03); /* 因為圖片變大了，放大效果調微幅一點（1.03倍）才不會太突兀 */
  }
  .nav-container { max-width: 1200px; margin: 0 auto; height: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0 20px; }
  .nav-links { display: flex; list-style: none; gap: 30px; margin: 0; padding: 0; }
  .nav-links a { color: #ccc; text-decoration: none; font-size: 1.1rem; transition: color 0.3s; }
  .nav-links a:hover { color: #da9100; }
  .page-section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 130px; /* 🆙 這裡也要同步改成 130px！預留導覽列的高度，後面的遊戲內容才不會被壓在選單下方 */
    box-sizing: border-box;
  }
  .section-content { max-width: 1000px; width: 100%; padding: 40px; text-align: center; }
  .hero-bg { background: #121225; }
  .story-bg { background: #1a1a3a; }
  .features-bg { background: #121225; }
  .characters-bg { background: #1a1a3a; }
  .lang-switch { color: #666; font-size: 1rem; }
  .lang-switch a { color: #aaa; text-decoration: none; margin: 0 5px; transition: color 0.3s; }
  .lang-switch a:hover { color: #da9100; }
  .lang-switch a.active { color: #da9100; font-weight: bold; }
</style>
