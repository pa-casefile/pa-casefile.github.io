---
// 繁體中文首頁
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>普魯登蒂亞學園事件簿 | 官方網站</title>
  </head>
  <body>
    <!-- 1. 置頂快捷導覽列 -->
    <nav class="sticky-nav">
      <div class="nav-container">
        <div class="logo">
          <a href="/">
            <img src="/images/logo_zh.webp" alt="遊戲標題" class="logo-img" />
          </a>
        </div>
        <ul class="nav-links">
          <li><a href="#hero">首頁</a></li>
          <li><a href="#story">劇情內容</a></li>
          <li><a href="#features">遊戲特式</a></li>
          <li><a href="#characters">角色介紹</a></li>
        </ul>
        <!-- 👇 新增的語言切換鈕 👇 -->
        <div class="lang-switch">
          <a href="/" class="active">繁體中文</a> |
          <a href="/en/">English</a> |
          <a href="/ja/">日本語</a>
        </div>
      </div>
    </nav>

    <!-- 2. 直立式單頁內容區塊 -->
    <main class="one-page-scroll">
      <!-- 區塊：首頁 (Hero Section) -->
      <section id="hero" class="page-section hero-bg">
        <!-- 👇 新增：鎖定在首頁右下角的圖片按鈕容器 👇 -->
        <div class="hero-action-buttons">
          <!-- 👇 新增：置頂的 X 社群按鈕盒子 👇 -->
          <div class="hero-x-box">
            <a
              href="https://x.com/pa_casefile"
              target="_blank"
              rel="noopener noreferrer"
              class="hero-x-link"
              title="關注官方 X 獲取最新開發情報"
            >
              <img src="/images/x_logo.webp" alt="官方 X" class="x-btn-img" />
            </a>
          </div>
          <!-- 📦 下方原本的雙按鈕 -->
          <div class="game-buttons-row">
            <!-- 📦 按鈕一：試玩下載 (直接連結至 PC build release 的 zip 檔) -->
            <a
              href="https://github.com/pa-casefile/pa-casefile-pc/releases/download/v0.1/PrudentiaAcademy-0.1-pc.zip"
              class="hero-btn-link"
              title="下載 PC 試玩版"
            >
              <img
                src="/images/btn_download_zh.webp"
                alt="試玩下載"
                class="action-btn-img"
              />
            </a>

            <!-- 🌐 按鈕二：網上試玩 (開新視窗/新分頁連至 web build 的 GitHub Pages) -->
            <a
              href="https://pa-casefile.github.io/pa-casefile-web/"
              target="_blank"
              rel="noopener noreferrer"
              class="hero-btn-link"
              title="開啟網頁版直接玩"
            >
              <img
                src="/images/btn_play_zh.webp"
                alt="網上試玩"
                class="action-btn-img"
              />
            </a>
          </div>
        </div>
      </section>

      <!-- 區塊：劇情內容 -->
      <section id="story" class="page-section story-bg">
        <div class="section-content story-layout">
          <!-- 🖼️ 上方：劇情截圖區（佔 2/3 空間） -->
          <div class="story-image-wrapper">
            <img src="/images/story_01.webp" alt="劇情截圖" class="story-img" />
          </div>

          <!-- 📜 下方：故事文案區（佔 1/3 空間） -->
          <div class="story-text-wrapper">
            <p class="story-highlight">「只要破了這宗案，你就能活下去。」</p>
            <p class="story-desc">
              一位自稱「死神」的少女，突然將你強行帶到了異世界的魔法學園，命令你在此學習探案技巧。<br
              />
              她的目的，僅僅是為了一宗即將發生的神祕凶案──而那宗凶案的受害者，竟然是「全人類」！
            </p>
          </div>
        </div>
      </section>

      <!-- 區塊：遊戲特式 -->
      <section id="features" class="page-section features-bg">
        <div class="section-content features-layout">
          <!-- 💡 已依據需求移除 <h2> 標題，讓內容純粹留給輪播大圖 -->

          <!-- 🎡 輪播圖主容器 -->
          <div class="carousel-container">
            <!-- ⬅️ 左切換按鈕 -->
            <button
              class="carousel-btn prev-btn"
              id="prevBtn"
              aria-label="上一張">&#10094;</button
            >

            <!-- 🖼️ 中央截圖視窗 -->
            <div class="carousel-window">
              <div class="carousel-track" id="carouselTrack">
                <div class="carousel-slide">
                  <img src="/images/features_01_zh.webp" alt="學園生活1" />
                </div>
                <div class="carousel-slide">
                  <img src="/images/features_02_zh.webp" alt="學園生活2" />
                </div>
                <div class="carousel-slide">
                  <img src="/images/features_03_zh.webp" alt="搜查推理1" />
                </div>
                <div class="carousel-slide">
                  <img src="/images/features_04_zh.webp" alt="搜查推理2" />
                </div>
              </div>
            </div>

            <!-- ➡️ 右切換按鈕 -->
            <button
              class="carousel-btn next-btn"
              id="nextBtn"
              aria-label="下一張">&#10095;</button
            >
          </div>

          <!-- 🟢 下方圓點指示器 -->
          <div class="carousel-dots" id="carouselDots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
            <span class="dot" data-index="3"></span>
          </div>
        </div>
      </section>

      <!-- 區塊：角色介紹 -->
      <section id="characters" class="page-section char-bg">
        <div class="section-content char-layout">
          <!-- 🏛️ 左側區域：文字資訊、切換箭頭與頭像選單 -->
          <div class="char-left-zone">
            <!-- 📜 左側上部：人物故事資訊卡（內含 6 位角色的文字軌道） -->
            <div class="char-info-window">
              <div class="char-info-track" id="charInfoTrack">
                <!-- 角色 1 -->
                <div class="char-info-slide">
                  <h3 class="char-name">你</h3>
                  <span class="char-tag">冥河邊的呆瓜</span>
                  <p class="char-bio">
                    死後被摩依絲帶來異世界的少年，並成為了死神的眷屬。據摩依絲所說，少年一生將經歷無數次死劫；但成為死神的眷屬也許能助他化險為夷，彷彿是一種以毒攻毒的概念。
                  </p>
                </div>

                <!-- 角色 2 -->
                <div class="char-info-slide">
                  <h3 class="char-name">摩依絲</h3>
                  <span class="char-tag">霜白烏鴉</span>
                  <p class="char-bio">
                    霜白死神摩依絲──一個令人聞風喪膽的神名，也是把你帶到異世界的幕後黑手，真身卻是一位可愛的女孩子。話雖如此，她的神力無容置疑，亦理所當然是你的主神。
                  </p>
                </div>

                <!-- 角色 3 -->
                <div class="char-info-slide">
                  <h3 class="char-name">艾萪</h3>
                  <span class="char-tag">空想大魔法書</span>
                  <p class="char-bio">
                    提亞德家族的貴族千金。但她更有名的是其淵博的魔法知識，博覽群書且過目不忘，求知若渴，甚至有「無所不曉」的稱號。除了愛看書之外還有個不為人知的小秘密。
                  </p>
                </div>

                <!-- 角色 4 -->
                <div class="char-info-slide">
                  <h3 class="char-name">奧芬妮</h3>
                  <span class="char-tag">不存在者</span>
                  <p class="char-bio">
                    溫柔且富有包容力的大姐姐其實是一位很厲害的死靈法師，來自一個無人知曉的戈爾吉拉家族。不知什麼原因經常撐著一把蕾絲傘子，即使在室內也堅持撐傘。
                  </p>
                </div>

                <!-- 角色 5 -->
                <div class="char-info-slide">
                  <h3 class="char-name">尤麗狄克</h3>
                  <span class="char-tag">孤高的天才</span>
                  <p class="char-bio">
                    神秘、強大、寡言的小女孩，有著「千年不遇」的天才稱號。似乎與普魯登蒂亞的學園長互相認識。
                  </p>
                </div>

                <!-- 角色 6 -->
                <div class="char-info-slide">
                  <h3 class="char-name">曼妮婭</h3>
                  <span class="char-tag">海風少女</span>
                  <p class="char-bio">
                    外表跟你在原本世界認識的一位女同學一模一樣，也是叫小曼。但真實身分仍然是個謎，她亦聲稱失去了大部分的記憶。個性內向、膽小，對尤麗狄克顯得十分依賴。
                  </p>
                </div>
              </div>
            </div>

            <!-- 🎮 左側下部：左右箭頭與 6 個角色頭像點選選單 -->
            <div class="char-nav-wrapper">
              <!-- ⬅️ 左箭頭 -->
              <button
                class="char-arrow-btn"
                id="charPrevBtn"
                aria-label="上一個角色">&#10094;</button
              >

              <!-- 6位角色的橫向點選頭像 -->
              <div class="char-avatar-menu">
                <div class="avatar-box active" data-char="0">
                  <img src="/images/ch_thumb_01.webp" alt="頭像1" />
                </div>
                <div class="avatar-box" data-char="1">
                  <img src="/images/ch_thumb_02.webp" alt="頭像2" />
                </div>
                <div class="avatar-box" data-char="2">
                  <img src="/images/ch_thumb_03.webp" alt="頭像3" />
                </div>
                <div class="avatar-box" data-char="3">
                  <img src="/images/ch_thumb_04.webp" alt="頭像4" />
                </div>
                <div class="avatar-box" data-char="4">
                  <img src="/images/ch_thumb_05.webp" alt="頭像5" />
                </div>
                <div class="avatar-box" data-char="5">
                  <img src="/images/ch_thumb_06.webp" alt="頭像6" />
                </div>
              </div>

              <!-- ➡️ 右箭頭 -->
              <button
                class="char-arrow-btn"
                id="charNextBtn"
                aria-label="下一個角色">&#10095;</button
              >
            </div>
          </div>

          <!-- 🖼️ 右側區域：角色去背全身立繪展示窗 -->
          <div class="char-right-zone">
            <div class="char-image-window">
              <div class="char-image-track" id="charImageTrack">
                <div class="char-img-slide">
                  <img src="/images/ch_full_01.webp" alt="角色1立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_02.webp" alt="角色2立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_03.webp" alt="角色3立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_04.webp" alt="角色4立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_05.webp" alt="角色5立繪" />
                </div>
                <div class="char-img-slide">
                  <img src="/images/ch_full_06.webp" alt="角色6立繪" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  /* 這裡的 CSS 樣式三個語言檔案都通用，我把多語言的樣式寫在最下方 */
  html {
    scroll-behavior: smooth;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: sans-serif;
    margin: 0;
    background-color: #0b0b16;
    color: #fff;
  }
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 130px; /* 🆙 從 70px 放大到 130px，讓 100px 的 LOGO 上下各有 15px 的完美留白 */
    background: rgba(11, 11, 22, 0.85);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .logo-img {
    height: 100px; /* 🔒 依你所願，強制鎖定高度為 100 像素 */
    width: auto; /* 📐 寬度依舊等比例縮放，確保圖片不扁塌變形 */
    display: block;
    object-fit: contain;
    transition: transform 0.2s;
  }
  .logo-img:hover {
    transform: scale(
      1.03
    ); /* 因為圖片變大了，放大效果調微幅一點（1.03倍）才不會太突兀 */
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 1.1rem;
    transition: color 0.3s;
  }
  .nav-links a:hover {
    color: #da9100;
  }
  .page-section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 130px; /* 🆙 這裡也要同步改成 130px！預留導覽列的高度，後面的遊戲內容才不會被壓在選單下方 */
    box-sizing: border-box;
  }
  .section-content {
    max-width: 1000px;
    width: 100%;
    padding: 40px;
    text-align: center;
  }
  /* 🎮 首頁主視覺背景圖設定 */
  .hero-bg {
    background-image: url("/images/main_title.webp");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative; /* 🎯 核心：必須是相對定位，右下角的按鈕才能以此為基準定錨 */
    width: 100%;
    height: 100vh;
  }

  /* 🎯 核心控制：大容器改為「垂直上下堆疊」 */
  .hero-action-buttons {
    position: absolute;
    right: 60px;
    bottom: 50px;
    display: flex;
    flex-direction: column; /* 🎯 修正：改為直向排列 */
    align-items: flex-end; /* 📐 核心：讓 X 按鈕向右對齊，與下方的按鈕邊緣完美對齊 */
    gap: 90px; /* ↕️ X 按鈕與下方按鈕之間拉出 90 像素的精緻空隙 */
    z-index: 20;
  }

  /* 🐦 X 按鈕專用獨立盒子 */
  .hero-x-box {
    display: block;
  }

  .hero-x-link {
    display: block;
    text-decoration: none;
  }

  /* 🖼️ X 官方黑色/白色 Logo 尺寸控制 */
  .x-btn-img {
    height: 40px; /* 🔒 寬厚度控制在 40 像素（比遊戲按鈕稍小，維持主次分明的視覺階層） */
    width: auto;
    display: block;
    object-fit: contain;
    cursor: pointer;

    /* 🪄 給 X 加上白邊微光與黑影，防止它在深夜或暗色背景中完全隱形 */
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.6))
      drop-shadow(0 0 2px rgba(255, 255, 255, 0.2));
    transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* 🔥 X 按鈕滑鼠懸停（Hover）：仿官方的滑順放大 */
  .x-btn-img:hover {
    transform: scale(1.1); /* 🆙 懸停時優雅放大 1.1 倍 */
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.7)) brightness(1.2); /* 💡 微微提亮 */
  }

  /* 📦 下方雙按鈕橫向並排盒子 */
  .game-buttons-row {
    display: flex;
    flex-direction: row; /* ↔️ 原本的雙按鈕繼續保持橫向並排 */
    gap: 20px;
  }

  /* 🖼️ 原本的遊戲按鈕樣式保持不動 */
  .action-btn-img {
    height: 65px;
    width: auto;
    display: block;
    object-fit: contain;
    cursor: pointer;
    filter: drop-shadow(0 8px 15px rgba(0, 0, 0, 0.5));
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .action-btn-img:hover {
    transform: translateY(-4px);
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.65)) brightness(1.1);
  }
  .action-btn-img:active {
    transform: translateY(-1px);
  }

  /* 📱 手機端排版校正：當玩家用手機看時，全部歸位居中堆疊 */
  @media (max-width: 768px) {
    .hero-action-buttons {
      right: 50%;
      transform: translateX(50%);
      bottom: 30px;
      align-items: center; /* 📱 手機上改為水平正居中對齊 */
      gap: 12px;
    }
    .game-buttons-row {
      gap: 15px;
    }
    .action-btn-img {
      height: 50px;
    }
    .x-btn-img {
      height: 35px;
    } /* 📱 手機版 X 按鈕同步縮小到 35 像素 */
  }

  /* 🔮 1. 故事區域背景：放入你的模糊背景大圖 */
  .story-bg {
    background-image: url("/images/story_bg_blur.webp"); /* 🎯 這裡換上你模糊化處理後的大背景圖 */
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
  }

  /* 🖼️ 2. 微調截圖樣式：讓它在模糊背景前更立體 */
  .story-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 12px; /* 稍微加大圓角，更顯精緻 */
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6); /* 加深陰影，讓截圖從背景中「跳」出來 */
  }

  /* 📜 3. 核心：將文字用半透明黑色方塊包起來 */
  .story-text-wrapper {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 800px; /* 📐 限制方塊的最大寬度，避免在寬螢幕上拉得太寬 */
    text-align: center;

    /* 👇 半透明黑色方塊的核心程式碼 👇 */
    background: rgba(
      0,
      0,
      0,
      0.65
    ); /* 🖤 黑色底色，0.65 代表 65% 的透明度，既能擋住背景，又能隱約透出後方色彩 */
    padding: 25px 40px; /* ↕️ 幫方塊內部留出上下 25px、左右 40px 的舒適閱讀空間 */
    border-radius: 16px; /* ⚪ 柔和的圓角外框 */
    border: 1px solid rgba(255, 255, 255, 0.1); /* ✨ 極細的半透明白邊，能幫方塊增加一圈優雅的高級「科技/魔法邊框感」 */
    backdrop-filter: blur(
      5px
    ); /* 🌫️ 如果你希望黑色方塊自己也有二次模糊效果，可以加上這行（選用） */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); /* 底部加上柔和陰影 */
  }

  /* 調整字體邊距，讓它在方塊內更好看 */
  .story-highlight {
    font-size: 1.6rem;
    font-weight: bold;
    color: #da9100;
    margin-top: 0; /* 🆕 消除方塊內頂部的多餘空間 */
    margin-bottom: 12px;
    letter-spacing: 2px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); /* 給金字加上黑陰影，更立體 */
  }

  .story-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #f0f0f0; /* 稍微調亮白字，對比度更高 */
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); /* 給白字加上黑陰影 */
  }

  /* 📱 行動端微調：讓手機版玩家看時，黑框不會擠滿螢幕 */
  @media (max-width: 768px) {
    .story-text-wrapper {
      padding: 20px 20px;
      width: 90%; /* 在手機上左右保留一點點邊距，看起來像一張懸浮的卡片 */
    }
  }

  /* 直立式上下配置容器 */
  .story-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
