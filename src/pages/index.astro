---
// src/pages/index.astro
// 這裡叫做 Frontmatter（有前後三個減號），用來放網頁設定
// 目前保持空白即可
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🔮 魔法學園養成冒險遊戲 | 官方網站</title>
</head>
<body>

  <!-- 1. 置頂快捷導覽列 -->
  <nav class="sticky-nav">
    <div class="nav-container">
      <div class="logo">🔮 GAME LOGO</div>
      <ul class="nav-links">
        <li><a href="#hero">首頁</a></li>
        <li><a href="#story">劇情內容</a></li>
        <li><a href="#features">遊戲特式</a></li>
        <li><a href="#characters">角色介紹</a></li>
      </ul>
    </div>
  </nav>

  <!-- 2. 直立式單頁內容區塊 -->
  <main class="one-page-scroll">
    
    <!-- 區塊：首頁 -->
    <section id="hero" class="page-section hero-bg">
      <div class="section-content">
        <h1>🎮 遊戲主視覺與標題</h1>
        <p>最新試玩版 / Web 網頁版一鍵開玩按鈕預留區</p>
      </div>
    </section>

    <!-- 區塊：劇情內容 -->
    <section id="story" class="page-section story-bg">
      <div class="section-content">
        <h2>🔮 劇情內容</h2>
        <p>中世紀魔法學園「玻里蒂亞」的探案故事背景...</p>
      </div>
    </section>

    <!-- 區塊：遊戲特式 -->
    <section id="features" class="page-section features-bg">
      <div class="section-content">
        <h2>🏫 遊戲特式</h2>
        <p>屬性養成、日常課堂、突發搜查事件系統展示...</p>
      </div>
    </section>

    <!-- 區塊：角色介紹 -->
    <section id="characters" class="page-section characters-bg">
      <div class="section-content">
        <h2>🔍 角色介紹</h2>
        <p>lynceus, eurydike 等登場人物動態卡片預留區...</p>
      </div>
    </section>

  </main>

</body>
</html>

<!-- 👇 新手看這裡：所有的 CSS 樣式全部放在這裡！ 👇 -->
<style>
  /* 全域滾動流暢化設定 */
  html {
    scroll-behavior: smooth; /* 讓畫面跳轉時用「滑動」的方式呈現，而不是瞬間切換 */
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: sans-serif;
    margin: 0;
    background-color: #0b0b16; /* 深色中世紀奇幻底色 */
    color: #fff;
  }

  /* 1. 置頂快捷導覽列樣式 */
  .sticky-nav {
    position: fixed; /* 固定在螢幕頂部，滾動時不會消失 */
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: rgba(11, 11, 22, 0.85); /* 半透明深色背景 */
    backdrop-filter: blur(10px); /* 磨砂玻璃模糊效果 */
    z-index: 1000; /* 確保選單永遠擋在遊戲內容上方 */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }

  .nav-links {
    display: flex;
    list-style: none; /* 拔掉超連結預設的點點 */
    gap: 30px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #ccc;
    text-decoration: none; /* 拔掉超連結預設的底線 */
    font-size: 1.1rem;
    transition: color 0.3s; /* 讓滑鼠移上去變色時有漸變效果 */
  }

  .nav-links a:hover {
    color: #da9100; /* 滑鼠移上去時變成金色 */
  }

  /* 2. 單頁滿版區塊樣式 */
  .page-section {
    width: 100%;
    min-height: 100vh; /* 強制讓每一個區塊的高度，都剛好撐滿玩家的「一整個螢幕」 */
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 70px; /* 預留 70px 給頂部選單，字才不會被擋住 */
    box-sizing: border-box;
  }

  /* 內容置中容器 */
  .section-content {
    max-width: 1000px;
    width: 100%;
    padding: 40px;
    text-align: center;
  }

  /* 臨時的測試背景色，方便你拉拉看網頁，後面會換成精美的遊戲圖 */
  .hero-bg { background: #121225; }
  .story-bg { background: #1a1a3a; }
  .features-bg { background: #121225; }
  .characters-bg { background: #1a1a3a; }
</style>
